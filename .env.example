# Copy to .env. Never commit .env. Settings are read by app/infra/settings.py.
# Docker Compose reads the POSTGRES_* values for the db container.
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=ledgerly
# The app connects with the same user. Compose uses host "db"; from your laptop use "localhost:5433" (5432 is often taken by a local Postgres).
DATABASE_URL=postgresql+psycopg://ledgerly:change-me-dev-only@localhost:5433/ledgerly
# Required, at least 32 characters. The app refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_SECONDS=3600
LOG_LEVEL=INFO
